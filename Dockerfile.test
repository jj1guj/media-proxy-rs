# cargo test 用のネイティブビルド環境。
# apt 依存を焼き込み、以降のテスト実行では cargo の増分ビルドのみになるようにする。
#
# 使い方:
#   docker build -f Dockerfile.test -t media-proxy-test .
#   docker run --rm -it \
#     -v "$PWD":/app -w /app \
#     -v mp_cargo:/usr/local/cargo/registry \
#     -v mp_target:/app/target \
#     media-proxy-test cargo test
FROM rust:latest
RUN rustup component add clippy
RUN apt-get update && apt-get install -y \
  build-essential clang pkg-config nasm cmake git meson ninja-build \
    && rm -rf /var/lib/apt/lists/*
COPY crossfiles/build-imagemagick.sh /tmp/crossfiles/build-imagemagick.sh
RUN IMAGEMAGICK_PREFIX=/opt/imagemagick bash /tmp/crossfiles/build-imagemagick.sh
ENV IMAGEMAGICK_PREFIX=/opt/imagemagick
WORKDIR /app
