logging {
	level  = "info"
	format = "logfmt"
}

otelcol.receiver.otlp "media_proxy" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.processor.batch.media_proxy.input]
	}
}

otelcol.processor.batch "media_proxy" {
	timeout         = "200ms"
	send_batch_size = 1024

	output {
		metrics = [otelcol.exporter.prometheus.media_proxy.input]
	}
}

otelcol.exporter.prometheus "media_proxy" {
	forward_to         = [prometheus.remote_write.existing.receiver]
	include_scope_info = false
}

prometheus.remote_write "existing" {
	endpoint {
		url            = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
		remote_timeout = "3s"

		queue_config {
			batch_send_deadline  = "200ms"
			max_samples_per_send = 1000
			max_shards           = 4
		}
	}
}

discovery.docker "local" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "1s"
}

discovery.relabel "media_proxy" {
	targets = discovery.docker.local.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = sys.env("MEDIA_PROXY_SERVICE_REGEX")
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/?(.*)"
		replacement   = "$1"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "media_proxy" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.relabel.media_proxy.output
	labels           = {"job" = "media-proxy-rs"}
	refresh_interval = "1s"
	forward_to       = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
