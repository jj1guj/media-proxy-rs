{
  "bind_addr": "0.0.0.0:12766",
  "timeout": 30000,
  "user_agent": "https://github.com/jj1guj/media-proxy-rs",
  "max_size": 268435456,
  "proxy": null,
  "filter_type": "Triangle",
  "max_pixels": 2048,
  "append_headers": [
    "Content-Security-Policy:default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'",
    "Access-Control-Allow-Origin:*"
  ],
  "load_system_fonts": true,
  "webp_quality": 75.0,
  "encode_avif": false,
  "slow_log_ms": 50,
  "enable_cache": true,
  "cache_max_bytes": 1073741824,
  "cache_entry_max_bytes": 5242880,
  "cache_ttl_secs": 43200,
  "negative_cache_404_ttl_secs": 3600,
  "negative_cache_410_ttl_secs": 86400,
  "negative_cache_max_entries": 16384,
  "passthrough_max_bytes": 5242880,
  "dns_negative_ttl_secs": 10,
  "dns_timeout_ms": 4000,
  "dns_ttl_secs": 300,
  "dns_cache_max_entries": 4096,
  "jpeg_quality": 85,
  "webp_method": 4,
  "max_concurrent_downloads": 128,
  "inflight_buffer_budget_bytes": 536870912,
  "connect_timeout_ms": 10000,
  "fetch_retry_delay_ms": 500,
  "host_throttle": {
    "requests_per_second": 8.0,
    "burst": 16,
    "max_wait_ms": 15000,
    "max_hosts": 4096,
    "queue_capacity": 256,
    "observation_hosts": ["media.misskeyusercontent.com"],
    "observation_interval_ms": 10000,
    "proactive_hosts": {
      "media.misskeyusercontent.com": {
        "initial_requests_per_second": 2.0,
        "min_requests_per_second": 0.5,
        "max_requests_per_second": 8.0,
        "burst": 5,
        "decrease_factor": 0.7,
        "increase_step": 0.1,
        "increase_interval_secs": 60,
        "quiet_period_secs": 120,
        "mode": "shadow"
      }
    }
  },
  "cache_stale_max_secs": 86400,
  "enable_source_cache": true,
  "source_cache_path": "/var/cache/media-proxy/source",
  "source_cache_capacity_bytes": 26843545600,
  "source_cache_entry_max_bytes": 33554432,
  "source_cache_ttl_secs": 43200,
  "source_cache_stale_secs": 86400,
  "otlp_metrics_endpoint": "http://alloy:4318/v1/metrics",
  "otlp_export_interval_ms": 5000,
  "otlp_service_name": "media-proxy-rs",
  "unix_socket_permissions": "0666"
}
